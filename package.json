{
  "name": "money-compass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check-styles": "prettier -c \"**/*.{js,ts,jsx,tsx,json,css,md}\"",
    "check-types": "tsc --project tsconfig.json --pretty --noEmit",
    "validate": "npm-run-all --parallel check-types && lint-staged",
    "prepare": "husky",
    "test": "echo 'No tests.'",
    "supa:start": "supabase start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "supabase migration up && supabase gen types --schema=public --local > src/lib/types/database.types.ts",
    "db:migrate:remote": "supabase db push --linked",
    "db:backup": "mkdir -p backups && supabase db dump --local --data-only --file \"backups/backup_local_$(date +%Y%m%d_%H%M%S).sql\"",
    "db:backup:remote": "mkdir -p backups && supabase db dump --linked --data-only --file \"backups/backup_remote_$(date +%Y%m%d_%H%M%S).sql\"",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next-safe-action/adapter-react-hook-form": "^2.1.0",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@remixicon/react": "^4.9.0",
    "@standard-schema/spec": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "next": "^16.4.2",
    "next-safe-action": "^8.7.3",
    "next-themes": "^0.4.6",
    "nordigen-node": "patch:nordigen-node@npm%3A1.4.1#~/.yarn/patches/nordigen-node-npm-1.4.1-e20eb12fc3.patch",
    "nprogress": "^0.2.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.90.0",
    "react-number-format": "^5.4.5",
    "react-resizable-panels": "^3.0.6",
    "react-responsive": "^10.0.1",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.5",
    "@types/nprogress": "^0.2.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "packageManager": "yarn@4.18.1"
}
